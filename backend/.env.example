DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5176,http://127.0.0.1:5176
DATABASE_URL=sqlite:///db.sqlite3
# 独立的 Fernet 密钥；优先于文件。留空时使用受限密钥文件，不从 DJANGO_SECRET_KEY 派生。
CREDENTIAL_ENCRYPTION_KEY=
# 留空使用 backend/.runtime/secrets/credential.key；首次 migrate 前运行 initialize_credential_key。
CREDENTIAL_ENCRYPTION_KEY_FILE=
REVIEW_EXECUTE_INLINE=false
PUBLIC_BASE_URL=
REVIEW_MAX_RETRIES=3
REVIEW_RETRY_BACKOFF_SECONDS=5
# 页面配置优先；这些变量仅用于首次启动/部署兜底。
GITLAB_REQUEST_TIMEOUT=8
LLM_REQUEST_TIMEOUT=30
WECOM_REQUEST_TIMEOUT=8
REVIEW_MAX_CONCURRENCY=1
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
CCSWITCH_BASE_URL=
CCSWITCH_API_KEY=
CCSWITCH_MODEL=
WECOM_WEBHOOK_URL=
