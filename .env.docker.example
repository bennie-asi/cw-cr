# Optional: copy to .env. Defaults work without this file.
CW_CR_IMAGE=ghcr.io/bennie-asi/cw-cr:latest
PORT=8080
BIND_ADDRESS=127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
# HTTP local trial. For public HTTPS deployments set true and configure origins.
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
# Leave empty to use persistent generated keys in /data/secrets.
DJANGO_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=sqlite:////data/db.sqlite3
# Page settings take precedence. A host gateway may use host.docker.internal.
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
CCSWITCH_BASE_URL=
CCSWITCH_API_KEY=
CCSWITCH_MODEL=
WECOM_WEBHOOK_URL=
